         image: 'mysql:8.0'
         ports:
-            - '${FORWARD_DB_PORT:-3311}:3306'
+            - '${FORWARD_DB_PORT:-33101}:3306'
         environment:
             MYSQL_ROOT_PASSWORD: '${DB_PASSWORD}'
             MYSQL_ROOT_HOST: '%'
@@ -53,7 +53,7 @@ services:
     redis:
         image: 'redis:7-alpine'
         ports:
-            - '${FORWARD_REDIS_PORT:-6379}:6379'
+            - '${FORWARD_REDIS_PORT:-63079}:6379'
         command: 'redis-server /usr/local/etc/redis/redis.conf'
         volumes:
             - 'sail-redis:/data'
@@ -70,8 +70,8 @@ services:
     minio:
         image: 'minio/minio:latest'
         ports:
-            - '${FORWARD_MINIO_PORT:-9000}:9000'
-            - '${FORWARD_MINIO_CONSOLE_PORT:-8900}:8900'
+            - '${FORWARD_MINIO_PORT:-19000}:9000'
+            - '${FORWARD_MINIO_CONSOLE_PORT:-18900}:8900'
         environment:
